{
  "compilerOptions": {
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@ledgerhq/device-management-kit": [
        "./node_modules/@ledgerhq/device-management-kit/lib/types/index.d.ts"
      ],
      "@ledgerhq/device-transport-kit-node-hid": [
        "./node_modules/@ledgerhq/device-transport-kit-node-hid/lib/types/index.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "./dist/**"
  ]
}
