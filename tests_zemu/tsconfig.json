{
  "compilerOptions": {
    "module": "node16",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "moduleResolution": "node16"
  },
  "exclude": [
    "node_modules",
    "./dist/**"
  ]
}
